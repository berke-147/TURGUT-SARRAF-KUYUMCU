# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir.
# .env dosyası ASLA paylaşılmamalı / git'e eklenmemelidir.

# Canlıya almadan önce yeni ve gizli bir SECRET_KEY üret:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=buraya-uretilen-yeni-anahtari-yapistir

# Canlı ortamda MUTLAKA False olmalı
DEBUG=False

# Alan adını / sunucu IP'sini virgülle ayırarak yaz
ALLOWED_HOSTS=turgutsarraf.com,www.turgutsarraf.com

# ------------------------------------------------------------------
# SEO / PAZARLAMA (hepsi opsiyonel - boş bırakırsan ilgili özellik
# sitede hiç görünmez, hata vermez)
# ------------------------------------------------------------------
SITE_DOMAIN=https://turgutsarraf.com

# Google Analytics 4 ölçüm kimliği (ör. G-XXXXXXXXXX) - analytics.google.com
GA4_MEASUREMENT_ID=

# Google Search Console "HTML etiketi" doğrulama kodu (content="..." içindeki değer)
GOOGLE_SITE_VERIFICATION=

# Google'da işletme olarak görünmek (LocalBusiness) için mağaza bilgileri.
# Boş bırakılırsa kod içindeki gerçek varsayılanlar (mevcut mağaza bilgileri)
# kullanılır - bunları SADECE farklı bir değerle değiştirmek istersen doldur.
BUSINESS_NAME=Turgut Sarraf Kuyumculuk
BUSINESS_PHONE=
BUSINESS_STREET_ADDRESS=
BUSINESS_CITY=
BUSINESS_POSTAL_CODE=

# Google Haritalar / LocalBusiness için mağaza konumu (ondalık derece)
BUSINESS_LATITUDE=
BUSINESS_LONGITUDE=

# WhatsApp yönlendirme/tıklama takibi için numara - uluslararası format,
# boşluksuz/artısız (ör. 905333633220)
WHATSAPP_NUMBER=
